# Firebase 웹 SDK 설정 입력 양식
# 이 파일은 빈 예시입니다. 실제 값은 .env.local에 입력하세요.
# firebaseConfig에서 각 항목의 값만 = 뒤에 복사하세요.
# JavaScript 코드, 쉼표, 세미콜론은 넣지 마세요.
# VITE_ 값은 웹 빌드에 포함됩니다. 서비스 계정·비공개 키·토큰은 넣지 마세요.

# apiKey
VITE_FIREBASE_API_KEY=

# authDomain
VITE_FIREBASE_AUTH_DOMAIN=

# projectId
VITE_FIREBASE_PROJECT_ID=

# storageBucket — SDK 설정에 있으면 입력하고, 없으면 비워 두세요.
VITE_FIREBASE_STORAGE_BUCKET=

# messagingSenderId
VITE_FIREBASE_MESSAGING_SENDER_ID=

# appId
VITE_FIREBASE_APP_ID=

# measurementId — 선택 항목. 없으면 비워 두세요.
VITE_FIREBASE_MEASUREMENT_ID=

# databaseURL — Realtime Database 전용 선택 항목. Firestore 주소를 넣지 마세요.
VITE_FIREBASE_DATABASE_URL=

# 배포한 함수의 직접 Cloud Run 주소 (경로 없이 https://api-....run.app)
VITE_API_BASE_URL=

# Google 제공자를 활성화한 경우에만 true. 기본 로그인은 이메일/비밀번호.
VITE_GOOGLE_SIGN_IN_ENABLED=false
