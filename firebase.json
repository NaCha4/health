{
  "functions": [
    {
      "source": "functions",
      "codebase": "health",
      "ignore": ["node_modules", ".git", "*.local", ".env", ".env.*", "src/**", "tsconfig.json"],
      "predeploy": ["npm run build --workspace functions", "npm run check:functions-package"]
    }
  ],
  "firestore": [
    { "database": "default", "rules": "firestore.rules", "indexes": "firestore.indexes.json" }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
