# 서버 전용 설정. 실제 값은 functions/.env.health-6b756 에 넣습니다.
# 배포 전 docs/deployment.md를 확인하세요. 이 예시는 자동 배포되지 않습니다.
# 첫 배포에서는 PUBLIC_BASE_URL을 비워 두면 서버가 503으로 닫힙니다.
# 배포 후 표시되는 직접 Cloud Run URL을 넣어 다시 배포합니다.
PUBLIC_BASE_URL=
FRONTEND_URL=
OWNER_UID=
OAUTH_CLIENT_ID=harugyeol-dot
OAUTH_REDIRECT_URIS=
FIRESTORE_DATABASE_ID=(default)
FUNCTION_REGION=asia-northeast3

# 선택 항목. 사용 중인 제공처의 키만 서버에 설정합니다.
# 브라우저의 VITE_ 설정에는 절대 넣지 않습니다.
USDA_API_KEY=
MFDS_API_KEY=
