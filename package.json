{
  "name": "dot-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && npm run build --workspace functions && npm run check:functions-package",
    "check:functions-package": "node scripts/check-functions-package.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "dev:server": "tsx scripts/dev-server.ts",
    "test:rules": "firebase emulators:exec --project demo-dot-health --config firebase.emulators.json --only firestore,auth \"vitest run --config vitest.integration.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
